rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.communityId == "ghmo-site" &&
        request.auth.token.role == "admin";
    }

    function isMember() {
      return request.auth != null &&
        request.auth.token.communityId == "ghmo-site" &&
        request.auth.token.role == "member" ||
        false;
    }

    match /organizations/{orgSlug}/home/blocks {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizations/{orgSlug}/donations/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizations/{orgSlug}/donations/webhookEvents/events/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/gumba/{doc=**} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /organizations/{orgSlug}/docgen/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/pins/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/members/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/auditLogs/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/timeline/{doc=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /organizations/{docId}/{any=**} {
      allow read, write: if false;
    }
  }
}
