rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The admin custom claim is permanent on a Firebase user, so it is not enough on
    // its own: the admin record must also exist and be active. Disabling an admin in
    // organizations/ghmo/admins/{uid} therefore cuts off database access immediately.
    function hasActiveAdminRecord() {
      let adminPath = /databases/$(database)/documents/organizations/ghmo/admins/$(request.auth.uid);
      return exists(adminPath) && get(adminPath).data.status == "active";
    }

    // Admin data needs a passkey-backed token (plan decision D2). Tokens are minted by
    // /api/auth/firebase-custom-token, which copies the session's `authMethod` claim. "dev" is
    // only ever issued by the local dev bypass, which is disabled in production.
    function hasStrongAuth() {
      return request.auth.token.authMethod == "passkey" || request.auth.token.authMethod == "dev";
    }

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.communityId == "ghmo-site" || request.auth.token.orgSlug == "ghmo") &&
        (request.auth.token.role == "admin" || request.auth.token.admin == true) &&
        hasStrongAuth() &&
        hasActiveAdminRecord();
    }

    function isMember() {
      return request.auth != null &&
        request.auth.token.communityId == "ghmo-site" &&
        request.auth.token.role == "member" ||
        false;
    }

    match /organizations/{orgSlug}/home/blocks {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizations/{orgSlug}/donations/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizations/{orgSlug}/donations/webhookEvents/events/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/gumba/{doc=**} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /organizations/{orgSlug}/docgen/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/members/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /organizations/{orgSlug}/auditLogs/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Deprecated: Timeline entries are being replaced by meeting minutes.
    match /organizations/{orgSlug}/timeline/{doc=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Minutes are written only through /api/admin/minutes (status rules, device checks, audit);
    // admins may read them, and their content is ciphertext once encryption is on.
    match /organizations/{orgSlug}/minutes/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- End-to-end encryption (plan Phase 4) ----
    // Once the keyring is enabled, private fields must be stored as an encrypted
    // envelope and plaintext copies are refused. Before that, plaintext still works.
    function e2eeOn() {
      let statePath = /databases/$(database)/documents/organizations/ghmo/e2ee/state;
      return exists(statePath) && get(statePath).data.enabled == true;
    }

    // The writing device must be an ACTIVE device owned by the signed-in admin.
    function deviceBelongsTo(deviceId, uid) {
      let devicePath = /databases/$(database)/documents/organizations/ghmo/e2ee/state/devices/$(deviceId);
      return exists(devicePath) &&
        get(devicePath).data.uid == uid &&
        get(devicePath).data.status == "active";
    }

    function isEnvelope(e) {
      return e is map &&
        e.keys().hasOnly(['v', 'epoch', 'dev', 'iv', 'ct', 'sig']) &&
        e.keys().hasAll(['v', 'epoch', 'dev', 'iv', 'ct', 'sig']) &&
        e.v == 1 &&
        e.epoch is int && e.epoch >= 1 &&
        e.dev is string && e.dev.size() >= 16 && e.dev.size() <= 64 &&
        e.iv is string && e.iv.size() == 16 &&
        e.ct is string && e.ct.size() >= 22 && e.ct.size() <= 200000 &&
        e.sig is string && e.sig.size() >= 64 && e.sig.size() <= 200;
    }

    // A newly written envelope: well-formed and written by one of the caller's own devices.
    function isFreshEnvelope(e) {
      return isEnvelope(e) && deviceBelongsTo(e.dev, request.auth.uid);
    }

    // On updates, an envelope may also be carried over unchanged from the existing document
    // (another admin bumping a counter must not need the author's device).
    function envelopeOkOnUpdate(field) {
      return (resource.data.get(field, null) == request.resource.data.get(field, null) &&
              isEnvelope(request.resource.data.get(field, null))) ||
        isFreshEnvelope(request.resource.data.get(field, null));
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function commsThreadPath(threadId) {
      return /databases/$(database)/documents/organizations/ghmo/commsThreads/$(threadId);
    }

    function isThreadOpen(threadId) {
      return get(commsThreadPath(threadId)).data.status == "open";
    }

    function isValidThreadCreate() {
      return (e2eeOn()
          ? (!('title' in request.resource.data) && !('body' in request.resource.data) &&
             isFreshEnvelope(request.resource.data.get('enc', null)))
          : (isNonEmptyString(request.resource.data.get('title', null)) &&
             isNonEmptyString(request.resource.data.get('body', null)) &&
             !('enc' in request.resource.data))) &&
        request.resource.data.status == "open" &&
        request.resource.data.createdBy.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lastActivityAt == request.time;
    }

    // A conclusion is plaintext {text} (before encryption is on) or an envelope {enc}.
    function hasConclusionText() {
      let c = request.resource.data.get('conclusion', null);
      return c is map &&
        (e2eeOn()
          ? ((c.get('enc', null) != null &&
              ((resource.data.get('conclusion', {}).get('enc', null) == c.get('enc', null) && isEnvelope(c.enc)) ||
               isFreshEnvelope(c.enc)) &&
              !('text' in c)) ||
             // legacy plaintext conclusion carried over unchanged
             (isNonEmptyString(c.get('text', null)) &&
              resource.data.get('conclusion', {}).get('text', null) == c.text))
          : isNonEmptyString(c.get('text', null)));
    }

    // Title/body: plaintext before encryption is on; an envelope after. Legacy plaintext
    // threads stay editable by counters until the migration job encrypts them.
    function threadPrivateFieldsOk() {
      let d = request.resource.data;
      return e2eeOn()
        ? ((('enc' in d) && !('title' in d) && !('body' in d) && envelopeOkOnUpdate('enc')) ||
           (!('enc' in d) &&
            isNonEmptyString(d.get('title', null)) && isNonEmptyString(d.get('body', null)) &&
            d.get('title', null) == resource.data.get('title', null) &&
            d.get('body', null) == resource.data.get('body', null)))
        : (isNonEmptyString(d.get('title', null)) && isNonEmptyString(d.get('body', null)) && !('enc' in d));
    }

    function isTransitioningToClosing() {
      return resource.data.status == "open" &&
        request.resource.data.status == "closing";
    }

    function isTransitioningToClosed() {
      return resource.data.status == "closing" &&
        request.resource.data.status == "closed";
    }

    function isValidThreadUpdate() {
      return threadPrivateFieldsOk() &&
        (request.resource.data.status == "open" ||
          request.resource.data.status == "closing" ||
          request.resource.data.status == "closed") &&
        (resource.data.status == "closed" ? request.resource.data.status == "closed" : true) &&
        request.resource.data.createdBy.uid == resource.data.createdBy.uid &&
        (request.resource.data.status == "closing"
          ? hasConclusionText()
          : true) &&
        (isTransitioningToClosing()
          ? request.resource.data.conclusion.proposedBy.uid == request.auth.uid
          : true) &&
        (isTransitioningToClosed()
          ? (hasConclusionText() &&
            request.resource.data.finalizedBy.uid == request.auth.uid)
          : true);
    }

    function isValidCommentCreate() {
      return (e2eeOn()
          ? (!('body' in request.resource.data) && isFreshEnvelope(request.resource.data.get('enc', null)))
          : (isNonEmptyString(request.resource.data.get('body', null)) && !('enc' in request.resource.data))) &&
        (request.resource.data.get('parentId', null) == null || isNonEmptyString(request.resource.data.parentId)) &&
        request.resource.data.createdBy.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
    }

    // The vote's value is private once encryption is on; which admin voted (the document ID) is not.
    function isValidConclusionVote() {
      let d = request.resource.data;
      return e2eeOn()
        ? (d.keys().hasOnly(['enc', 'createdAt', 'createdBy']) &&
           d.get('createdBy', {}).get('uid', null) == request.auth.uid &&
           isFreshEnvelope(d.get('enc', null)))
        : (d.get('value', null) == "approve" || d.get('value', null) == "reject");
    }

    function isValidChatMessageCreate() {
      return request.resource.data.createdBy.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        (e2eeOn()
          ? (request.resource.data.keys().hasOnly(['enc', 'createdAt', 'createdBy']) &&
             isFreshEnvelope(request.resource.data.get('enc', null)))
          : (request.resource.data.keys().hasOnly(['body', 'createdAt', 'createdBy']) &&
             isNonEmptyString(request.resource.data.get('body', null))));
    }

    match /organizations/ghmo/commsThreads/{threadId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidThreadCreate();
      allow update: if isAdmin() && isValidThreadUpdate();
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && isThreadOpen(threadId) && isValidCommentCreate();
        allow update, delete: if false;

        match /likes/{uid} {
          allow read: if isAdmin();
          allow create: if isAdmin() &&
            request.auth.uid == uid &&
            request.resource.data.createdAt is timestamp &&
            request.resource.data.createdBy.uid == request.auth.uid &&
            isNonEmptyString(request.resource.data.createdBy.name);
          allow delete: if isAdmin() && request.auth.uid == uid;
          allow update: if false;
        }
      }

      match /conclusionVotes/{voteId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin() &&
          voteId == request.auth.uid &&
          get(/databases/$(database)/documents/organizations/ghmo/commsThreads/$(threadId)).data.status == "closing" &&
          isValidConclusionVote();
        allow delete: if false;
      }
    }

    match /organizations/ghmo/adminChatMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidChatMessageCreate();
      allow update, delete: if false;
    }

    match /organizations/{docId}/{any=**} {
      allow read, write: if false;
    }
  }
}
