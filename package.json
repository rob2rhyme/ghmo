{
  "name": "community-site-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 114",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "audit": "audit-ci --moderate",
    "test:emulators": "firebase emulators:exec --only firestore,auth --project demo-ghmo \"vitest run --config vitest.emulator.config.mts\"",
    "test:e2e:auth": "firebase emulators:exec --only firestore,auth --project demo-ghmo \"npm run build:e2e-auth && playwright test --config playwright.emulator.config.ts\"",
    "test:coverage": "vitest run --coverage",
    "build:e2e-auth": "NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ghmo NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroicons/react": "^2.2.0",
    "@react-pdf/renderer": "4.9.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "html-to-image": "1.11.11",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "4.2.1",
    "lucide-react": "^1.60.0",
    "nanoid": "5.1.16",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "svix": "1.17.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "22.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "audit-ci": "^7.1.0",
    "dotenv": "^17.2.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.0",
    "html-to-image": "^1.11.11",
    "postcss": "8.5.31",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "glob": "10.5.0",
    "undici": "6.29.1",
    "protobufjs": "7.6.6",
    "lodash": "4.18.1",
    "@jsdoc/salty": {
      "lodash": "4.18.1"
    },
    "requizzle": {
      "lodash": "4.18.1"
    },
    "catharsis": {
      "lodash": "4.18.1"
    },
    "@google-cloud/storage": "file:stubs/google-cloud-storage",
    "basic-ftp": "6.2.3",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    },
    "@firebase/firestore-compat": {
      "@grpc/grpc-js": "1.14.6"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
