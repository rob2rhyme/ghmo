    "undici": "6.29.1",
    "protobufjs": "7.6.6",
    "lodash": "4.17.23",
    "@jsdoc/salty": {
      "lodash": "4.17.23"
    },
    "requizzle": {
      "lodash": "4.17.23"
    },
    "catharsis": {
      "lodash": "4.17.23"
    },
    "@google-cloud/storage": "file:stubs/google-cloud-storage"
