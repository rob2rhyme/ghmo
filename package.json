{
  "name": "community-site-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 132",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "audit": "audit-ci --moderate",
    "test:emulators": "firebase emulators:exec --only firestore,auth --project demo-ghmo \"vitest run --config vitest.emulator.config.mts\"",
    "test:e2e:auth": "firebase emulators:exec --only firestore,auth --project demo-ghmo \"playwright test --config playwright.emulator.config.ts\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroicons/react": "2.1.5",
    "@react-pdf/renderer": "4.9.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "10.14.1",
    "firebase-admin": "13.10.0",
    "html-to-image": "1.11.11",
    "jsonwebtoken": "9.0.2",
    "jspdf": "4.2.1",
    "lucide-react": "1.52.0",
    "nanoid": "5.1.16",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "svix": "1.17.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@playwright/test": "1.64.1",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "22.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "audit-ci": "^7.1.0",
    "dotenv": "^17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.33.0",
    "html-to-image": "^1.11.11",
    "postcss": "8.5.31",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
