NEXT_PUBLIC_FIREBASE_API_KEY=your_client_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo
NEXT_PUBLIC_GOFUNDME_PRO_INSTALL_SNIPPET=<!-- paste GoFundMe Pro install snippet -->

FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=service-account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GOFUNDME_PRO_CLIENT_ID=
GOFUNDME_PRO_CLIENT_SECRET=
GOFUNDME_PRO_API_BASE=https://api.gofundme.com
GOFUNDME_PRO_WEBHOOK_SECRET= # optional until GoFundMe is wired

APP_ENV=dev

# Admin login: magic link only. PIN login is being removed (see docs/PROJECT_PLAN.md, decision D3).
FEATURE_EMAIL_ADMIN_LOGIN=true
FEATURE_PIN_LOGIN=false
