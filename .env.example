NEXT_PUBLIC_FIREBASE_API_KEY=your_client_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo
NEXT_PUBLIC_GOFUNDME_PRO_INSTALL_SNIPPET=<!-- paste GoFundMe Pro install snippet -->

FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=service-account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GOFUNDME_PRO_CLIENT_ID=
GOFUNDME_PRO_CLIENT_SECRET=
GOFUNDME_PRO_API_BASE=https://api.gofundme.com
GOFUNDME_PRO_WEBHOOK_SECRET= # optional until GoFundMe is wired

APP_ENV=dev

# Admin login: magic link only (PIN login was removed; see docs/PROJECT_PLAN.md, decision D3).
FEATURE_EMAIL_ADMIN_LOGIN=true

# One-time creation of the first super-admin via POST /api/admin/bootstrap.
# At least 32 random characters (e.g. `openssl rand -base64 48`). Remove it after bootstrap.
BOOTSTRAP_ADMIN_SECRET=

# Client IP for rate limits: how many proxies (counted from the right of
# X-Forwarded-For) append the real client IP. 1 is right for most hosts.
# Ignored on Vercel, which provides a trusted x-real-ip.
TRUSTED_PROXY_HOPS=1

# Public origin used in emailed magic links and signing links, e.g. https://ghmo.org.
# Set this in production so a forged Host header can't change link targets.
NEXT_PUBLIC_APP_URL=

# Signature encryption (AES-256-GCM). 32 random bytes, base64: `openssl rand -base64 32`.
# To rotate: move the old value into DOCGEN_SIGNATURE_ENC_PREVIOUS_KEYS_BASE64 (comma-separated).
DOCGEN_SIGNATURE_ENC_KEY_BASE64=
DOCGEN_SIGNATURE_ENC_PREVIOUS_KEYS_BASE64=

# Signs certificate verification records (HMAC-SHA-256). 32+ random bytes, base64: `openssl rand -base64 32`.
# Required to issue signed certificates. Keep it out of the database; changing it makes existing QR codes read as invalid.
CERTIFICATE_SIGNING_KEY_BASE64=

# Content-free notification emails (optional). Both must be set to send anything; leave empty to keep notifications off.
# Uses Resend's free tier: https://resend.com. The sender must be a domain you verified there.
RESEND_API_KEY=
# Broadcast email to members (Phase 8). The webhook secret is the "Signing secret" (starts with whsec_) of a Resend
# webhook that points at https://<your domain>/api/resend/webhook and sends email.bounced and email.complained.
RESEND_WEBHOOK_SECRET=
# Shown in the footer of every broadcast (required before any can be sent).
BROADCAST_ORG_NAME=
BROADCAST_POSTAL_ADDRESS=
NOTIFY_FROM_EMAIL=

# Local development only. Ignored in production builds. Token must be 32+ characters.
ALLOW_DEV_ADMIN_LOGIN=false
DEV_ADMIN_LOGIN_TOKEN=
